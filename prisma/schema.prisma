generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                  String  @id @default(uuid())
  title               String
  slug                String  @unique
  category            String
  image               String
  catalogPdf          String?
  description         String
  product_description String?
  features            Json
  size                String?
  weight              String?
  brand               String? @default("شیرآلات بارشی")
  model               String?
  color               String?
  material            String?
  faq                 Json?

  searchTags Json?

  seoTitle         String?
  seoDescription   String?
  semanticKeywords Json?
  canonicalUrl     String?

  comments ProductComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id       String @id @default(uuid())
  title    String
  slug     String @unique
  content  String
  category String
  image    String
  readTime String

  seoTitle       String?
  seoDescription String?
  keywords       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteInfo {
  id Int @id @default(1)

  phone          String?
  factoryAddress String?

  instagram String?
  telegram  String?
  bale      String?
  shopUrl   String?

  yearsOfExperience Int? @default(0)
  deliveredProducts Int? @default(0)
  trustedCustomers  Int? @default(0)
  coveredCountries  Int? @default(0)

  aboutImage   String?
  aboutTitle   String?
  aboutText    String?
  homePageText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id       String @id @default(uuid())
  question String
  answer   String
}

model Slider {
  id                String   @id @default(uuid())
  image             String
  title             String
  alt               String
  short_description String
  createdAt         DateTime @default(now())
}

model ProductComment {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name   String
  phone  String
  rating Int
  text   String

  status CommentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([status])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}
